# Database & Storage
DATA_SOURCE=supabase
STORAGE_SOURCE=local

# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ICPaaS WhatsApp & Messaging Gateway (icpaas.in)
ICPAAS_API_KEY=your-icpaas-api-key
ICPAAS_USERNAME=your-icpaas-username
ICPAAS_MOBILE=your-mobile-number
ICPAAS_EMAIL=your-email-address

# Session Security (random 32+ char string)
SESSION_SECRET=mind-spark-local-development-secret-key-32chars

# Competition Defaults
DEFAULT_SCHOOL_NAME="Mind-Spark Inter-School Competition"
DEFAULT_COMPETITION_TITLE="Annual Mind-Spark Academic Olympiad 2026"
DEFAULT_VENUE="MSITM DEGREE COLLEGE GONDA UTTAR PRADESH"
DEFAULT_EXAM_DATE="01 Nov 2026"
DEFAULT_REPORTING_TIME="09:00 AM"
DEFAULT_REG_PREFIX="MS"
