# Database source: "local" (default offline JSON), "supabase" (recommended cloud PostgreSQL), or "firestore"
DATA_SOURCE=local

# Supabase Configuration (Required when DATA_SOURCE=supabase)
# Get these from your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# WhatsApp Cloud API (Meta Official - 0% ban bulk messaging for 500-1000 msgs/day)
# Get these from developers.facebook.com -> WhatsApp -> API Setup
WHATSAPP_CLOUD_ACCESS_TOKEN=your-permanent-system-user-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-waba-account-id

# Storage source: "local" (default private storage) or "gdrive" (Google Drive API v3)
STORAGE_SOURCE=local

# Session Secret (random 32+ char string)
SESSION_SECRET=mind-spark-super-secure-session-secret-key-32chars

# Firebase Configuration (Required only when DATA_SOURCE=firestore)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Google Drive Configuration (Required only when STORAGE_SOURCE=gdrive)
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# School / Competition Defaults
DEFAULT_SCHOOL_NAME="Mind-Spark Inter-School Competition"
DEFAULT_COMPETITION_TITLE="Annual Mind-Spark Academic Olympiad 2026"
DEFAULT_VENUE="MSITM DEGREE COLLEGE GONDA UTTAR PRADESH"
DEFAULT_EXAM_DATE="01 Nov 2026"
DEFAULT_REPORTING_TIME="09:00 AM"
DEFAULT_REG_PREFIX="MS"
