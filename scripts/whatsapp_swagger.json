          },
          "category": {
            "type": "string",
            "nullable": true
          },
          "allow_category_change": {
            "type": "boolean",
            "nullable": true
          },
          "language": {
            "type": "string",
            "nullable": true
          },
          "library_template_name": {
            "type": "string",
            "nullable": true
          },
          "LIBRARY_TEMPLATE_BUTTON_INPUTS": {
            "type": "array",
            "items": {},
            "nullable": true
          },
          "components": {
            "type": "array",
            "items": {},
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "emailAddress": {
            "type": "string",
            "nullable": true
