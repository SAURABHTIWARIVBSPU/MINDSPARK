              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/{version}/{phoneNumberId}/messages": {
      "post": {
        "tags": [
          "WhatsApp API"
        ],
        "summary": "Send WhatsApp Message",
        "description": "Sends a WhatsApp message using a phone number ID.",
        "parameters": [
          {
            "name": "version",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^v\\d+\\.\\d+$",
              "type": "string"
            }
          },
          {
            "name": "phoneNumberId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "Raw JSON payload (schema-less)"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/{version}/channels": {
      "get": {
        "tags": [
          "WhatsApp API"
        ],
        "summary": "Get Channels",
        "description": "Retrieves all channels associated with a WABA ID.",
        "parameters": [
          {
            "name": "version",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^v\\d+\\.\\d+$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/{version}/{phoneNumberId}/media": {
      "post": {
        "tags": [
          "WhatsApp Media API"
        ],
        "summary": "Upload WhatsApp Media",
        "description": "Uploads media to Meta WhatsApp Cloud API and returns media_id",
        "parameters": [
          {
            "name": "version",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^v\\d+\\.\\d+$",
              "type": "string"
            }
          },
          {
            "name": "phoneNumberId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "required": [
                  "file"
                ],
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              },
              "encoding": {
                "file": {
                  "style": "form"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BaseCreateTemplateMessageRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
