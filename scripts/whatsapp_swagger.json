          "page": {
            "type": "integer",
            "format": "int32"
          },
          "limit": {
            "type": "integer",
            "format": "int32"
          },
          "total_pages": {
            "type": "integer",
            "format": "int32",
            "readOnly": true
          },
          "templates": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TemplateResponseDto"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ProviderButton": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
