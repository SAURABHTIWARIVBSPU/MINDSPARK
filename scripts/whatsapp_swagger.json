    "/{version}/{wabaId}/message_templates": {
      "get": {
        "tags": [
          "WhatsApp API"
        ],
        "summary": "Get Templates",
        "description": "Fetches all message templates associated with a given WABA ID.",
        "parameters": [
          {
            "name": "version",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^v\\d+\\.\\d+$",
              "type": "string"
            }
          },
          {
            "name": "wabaId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "after",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "tags": [
          "WhatsApp API"
        ],
        "summary": "Create Template",
        "description": "Creates a new WhatsApp message template for a specific WABA ID.",
        "parameters": [
          {
            "name": "version",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^v\\d+\\.\\d+$",
              "type": "string"
            }
          },
          {
            "name": "wabaId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BaseCreateTemplateMessageRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "delete": {
        "tags": [
          "WhatsApp API"
        ],
        "summary": "Delete Template",
        "description": "Deletes an existing WhatsApp message template using its HSM ID and name.",
        "parameters": [
          {
            "name": "version",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^v\\d+\\.\\d+$",
              "type": "string"
            }
          },
          {
            "name": "wabaId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hsm_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "name",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/{version}/{id}": {
      "get": {
        "tags": [
          "WhatsApp API"
        ],
        "summary": "Get Template or Media By ID",
        "description": "If phone_number_id is passed → Media API. Otherwise → Template API.",
        "operationId": "GetGraphNode",
        "parameters": [
          {
            "name": "version",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^v\\d+\\.\\d+$",
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "phone_number_id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/{version}/{templateId}": {
      "post": {
        "tags": [
          "WhatsApp API"
        ],
        "summary": "Edit Template",
        "description": "Updates an existing template by ID.",
        "parameters": [
          {
            "name": "version",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^v\\d+\\.\\d+$",
              "type": "string"
            }
          },
          {
            "name": "templateId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
