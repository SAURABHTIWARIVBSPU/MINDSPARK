          "body": {
            "type": "string",
            "nullable": true
          },
          "buttons": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderButton"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ProviderContent": {
        "type": "object",
        "properties": {
          "header": {
            "$ref": "#/components/schemas/ProviderHeader"
          },
          "body": {
            "type": "string",
            "nullable": true
          },
          "footer": {
            "type": "string",
            "nullable": true
          },
          "limited_time_offer": {
            "$ref": "#/components/schemas/ProviderLimitedTimeOffer"
